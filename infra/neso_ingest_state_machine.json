{
  "Comment": "GridWatch — invokes the NESO ingestion Lambda, runs the Glue transform job against that data, then loads the curated result into BigQuery, with retries at each step, on a schedule set by EventBridge.",
  "StartAt": "InvokeNesoIngestLambda",
  "States": {
    "InvokeNesoIngestLambda": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-west-2:YOUR_ACCOUNT_ID:function:gridwatch-neso-ingest",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "RunNesoTransformGlueJob"
    },
    "RunNesoTransformGlueJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "gridwatch-neso-transform"
      },
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Next": "LoadCuratedIntoBigQuery"
    },
    "LoadCuratedIntoBigQuery": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-west-2:YOUR_ACCOUNT_ID:function:gridwatch-bigquery-load",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "End": true
    }
  }
}
